{
  "name": "unified-personal-finance",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/mobile",
    "packages/shared",
    "packages/domain"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev:mobile": "npm run start -w apps/mobile",
    "dev": "concurrently -k -n API,WEB \"npm:dev:api\" \"npm:dev:web\"",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "test": "npm run test -w apps/api && npm run test -w apps/web",
    "start:web": "npm run dev:web",
    "start:mobile": "npm run dev:mobile"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "typescript": "^5.9.3"
  }
}
